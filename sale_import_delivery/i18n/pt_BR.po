#. module: sale_import_delivery
#: model:ir.model.fields,help:sale_import_delivery.field_sale_channel__sale_import_carrier_id
msgid "Carrier of the imported orders when no carrier matches the code sent by the channel. Without a carrier the shipping amount is only kept on the order."
msgstr "Transportadora dos pedidos importados quando nenhuma transportadora corresponde ao código enviado pelo canal. Sem transportadora, o valor do frete fica apenas registrado no pedido."

#. module: sale_import_delivery
#: model:ir.model.fields,field_description:sale_import_delivery.field_sale_order__channel_carrier_code
msgid "Channel Carrier Code"
msgstr "Código da transportadora no canal"

#. module: sale_import_delivery
#: model:ir.model.fields,field_description:sale_import_delivery.field_sale_order__channel_shipping_amount
msgid "Channel Shipping Amount"
msgstr "Valor do frete no canal"

#. module: sale_import_delivery
#: model_terms:ir.ui.view,arch_db:sale_import_delivery.view_order_form
msgid "Channel shipping"
msgstr "Frete do canal"

#. module: sale_import_delivery
#: model:ir.model.fields,help:sale_import_delivery.field_delivery_carrier__sale_import_code
msgid "Code sent by the sale channels for this carrier."
msgstr "Código enviado pelos canais de venda para esta transportadora."

#. module: sale_import_delivery
#: model:ir.model.fields,field_description:sale_import_delivery.field_sale_channel__sale_import_carrier_id
